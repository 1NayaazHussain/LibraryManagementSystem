<%- include('partials/head', { pageTitle: 'Edit Book' }) %>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'books' }) %>

    <main class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">✏️ Edit Book</h1>
                <p class="page-subtitle">Update book details</p>
            </div>
            <a href="/books" class="btn btn-ghost">← Back to Books</a>
        </div>

        <div class="form-card">
            <h2>📖 Edit: <%= book.title %></h2>

            <% if (error) { %>
                <div class="error-msg">⚠️ <%= error %></div>
            <% } %>

            <form action="/books/edit/<%= book.id %>" method="post" id="edit-book-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="title">Book Title *</label>
                        <input type="text" id="title" name="title" value="<%= book.title %>" required>
                    </div>
                    <div class="form-group">
                        <label for="author">Author *</label>
                        <input type="text" id="author" name="author" value="<%= book.author %>" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="genre">Genre</label>
                        <select id="genre" name="genre">
                            <option value="">Select Genre</option>
                            <% ['Technology','Computer Science','Mathematics','Fiction','Non-Fiction','Self-Help','Science','History','Biography','Other'].forEach(g => { %>
                                <option value="<%= g %>" <%= book.genre === g ? 'selected' : '' %>><%= g %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="isbn">ISBN</label>
                        <input type="text" id="isbn" name="isbn" value="<%= book.isbn || '' %>">
                    </div>
                </div>
                <div class="form-group">
                    <label for="quantity">Quantity *</label>
                    <input type="number" id="quantity" name="quantity" value="<%= book.quantity %>" min="0" required>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="submit-btn">💾 Save Changes</button>
                    <a href="/books" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</div>
<script>
    document.getElementById('edit-book-form').addEventListener('submit', () => {
        const btn = document.getElementById('submit-btn');
        btn.textContent = 'Saving...'; btn.disabled = true;
    });
</script>
</body>
</html>
