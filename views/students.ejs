<%- include('partials/head', { pageTitle: 'Students' }) %>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'students' }) %>

    <main class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">🎓 Students</h1>
                <p class="page-subtitle">Manage registered library students</p>
            </div>
            <a href="/students/add" class="btn btn-primary" id="add-student-btn">➕ Add Student</a>
        </div>

        <!-- Search Bar -->
        <form class="search-bar" method="GET" action="/students" id="students-search-form">
            <div class="search-input-wrap">
                <span class="search-icon">🔍</span>
                <input type="text" name="search" id="student-search" placeholder="Search by name, USN, or branch…" value="<%= search %>">
            </div>
            <button type="submit" class="btn btn-ghost">Search</button>
            <% if (search) { %>
                <a href="/students" class="btn btn-ghost">✕ Clear</a>
            <% } %>
        </form>

        <!-- Students Table -->
        <div class="table-card">
            <div class="table-header">
                <span class="table-title">All Students</span>
                <span class="table-count"><%= students.length %> student<%= students.length !== 1 ? 's' : '' %></span>
            </div>

            <% if (students.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">👥</div>
                    <p><% if (search) { %>No students match "<%= search %>"<% } else { %>No students registered yet.<% } %></p>
                </div>
            <% } else { %>
            <table id="students-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>USN</th>
                        <th>Name</th>
                        <th>Branch</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach((student, i) => { %>
                    <tr>
                        <td style="color:var(--text-muted); font-size:12px;"><%= i + 1 %></td>
                        <td>
                            <span style="font-family: monospace; font-size:13px; color: var(--accent-light);"><%= student.usn %></span>
                        </td>
                        <td><strong><%= student.name %></strong></td>
                        <td>
                            <span class="badge badge-teal"><%= student.branch %></span>
                        </td>
                        <td style="font-size:13px; color: var(--text-secondary);"><%= student.email || '—' %></td>
                        <td>
                            <div class="table-actions">
                                <a href="/students/edit/<%= student.usn %>" class="btn btn-ghost btn-sm">✏️ Edit</a>
                                <a href="/students/delete/<%= student.usn %>" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Delete student <%= student.name %>?')">
                                    🗑️ Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } %>
        </div>
    </main>
</div>
</body>
</html>
