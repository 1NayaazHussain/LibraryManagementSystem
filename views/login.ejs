<%- include('partials/head', { pageTitle: 'Login' }) %>
<body class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="logo-icon">📚</div>
            <div>
                <h1>LibraryMS</h1>
                <span>NMAMIT — Library Portal</span>
            </div>
        </div>

        <h2>Welcome back</h2>
        <p class="subtitle">Sign in to your librarian account</p>

        <% if (error) { %>
            <div class="error-msg">⚠️ <%= error %></div>
        <% } %>

        <form action="/login" method="post" id="login-form">
            <div class="form-group">
                <label for="email-input">Email Address</label>
                <input type="text" id="email-input" name="email" placeholder="librarian@nmamit.in" required autocomplete="email">
            </div>
            <div class="form-group">
                <label for="password-input">Password</label>
                <input type="password" id="password-input" name="password" placeholder="••••••••" required autocomplete="current-password">
            </div>
            <button type="submit" class="btn btn-primary btn-full" id="login-btn">
                Sign In →
            </button>
        </form>

        <p style="text-align:center; margin-top:20px; font-size:12px; color: var(--text-muted);">
            Library Management System &copy; 2024
        </p>
    </div>

    <script>
        document.getElementById('login-form').addEventListener('submit', function() {
            const btn = document.getElementById('login-btn');
            btn.textContent = 'Signing in...';
            btn.disabled = true;
        });
    </script>
</body>
</html>