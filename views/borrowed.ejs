<%- include('partials/head', { pageTitle: 'Borrowed Books' }) %>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'borrowed' }) %>

    <main class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">🔄 Borrowed Books</h1>
                <p class="page-subtitle">Track book issues and returns</p>
            </div>
        </div>

        <!-- Issue Book Panel -->
        <div class="issue-panel">
            <h3>📤 Issue a Book</h3>
            <form action="/borrowed/issue" method="post" id="issue-form">
                <div class="issue-grid">
                    <div class="form-group" style="margin:0;">
                        <label for="issue-student">Student</label>
                        <select id="issue-student" name="usn" required>
                            <option value="">Select Student</option>
                            <% students.forEach(s => { %>
                                <option value="<%= s.usn %>"><%= s.name %> (<%= s.usn %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label for="issue-book">Book</label>
                        <select id="issue-book" name="book_id" required>
                            <option value="">Select Book</option>
                            <% books.forEach(b => { %>
                                <option value="<%= b.id %>"><%= b.title %> (Qty: <%= b.quantity %>)</option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group" style="margin:0;">
                        <label for="return-date">Due Return Date</label>
                        <input type="date" id="return-date" name="return_date" required
                               min="<%= new Date().toISOString().split('T')[0] %>">
                    </div>
                    <div>
                        <label style="visibility:hidden; display:block; margin-bottom:6px;">.</label>
                        <button type="submit" class="btn btn-primary" id="issue-btn">📤 Issue</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Records Table -->
        <div class="table-card">
            <div class="table-header">
                <span class="table-title">Borrow Records</span>
                <span class="table-count"><%= records.length %> record<%= records.length !== 1 ? 's' : '' %></span>
            </div>

            <% if (records.length === 0) { %>
                <div class="empty-state">
                    <div class="empty-icon">📭</div>
                    <p>No borrow records yet. Issue a book above to get started.</p>
                </div>
            <% } else { %>
            <table id="borrowed-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Student</th>
                        <th>Book</th>
                        <th>Borrowed On</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% records.forEach((rec, i) => { %>
                    <tr style="<%= rec.is_overdue ? 'background: rgba(244,63,94,0.04);' : '' %>">
                        <td style="color:var(--text-muted); font-size:12px;"><%= i + 1 %></td>
                        <td>
                            <div><strong><%= rec.student_name || rec.usn %></strong></div>
                            <div style="font-size:11px; color:var(--text-muted); font-family:monospace;"><%= rec.usn %></div>
                        </td>
                        <td><%= rec.book_title || 'Unknown Book' %></td>
                        <td style="font-size:13px; color:var(--text-secondary);"><%= rec.borrowed_date %></td>
                        <td style="font-size:13px; <%= rec.is_overdue ? 'color:#fb7185;' : 'color:var(--text-secondary);' %>">
                            <%= rec.return_date %>
                            <% if (rec.is_overdue) { %><span style="font-size:10px; display:block; color:#fb7185;">⚠️ Overdue</span><% } %>
                        </td>
                        <td>
                            <% if (rec.status === 'borrowed') { %>
                                <span class="badge <%= rec.is_overdue ? 'badge-rose' : 'badge-amber' %>">
                                    <%= rec.is_overdue ? '⚠️ Overdue' : '🔄 Borrowed' %>
                                </span>
                            <% } else { %>
                                <span class="badge badge-emerald">✅ Returned</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (rec.status === 'borrowed') { %>
                                <a href="/borrowed/return/<%= rec.id %>" class="btn btn-success btn-sm"
                                   onclick="return confirm('Mark this book as returned?')">
                                    ✅ Return
                                </a>
                            <% } else { %>
                                <span style="font-size:12px; color:var(--text-muted);">—</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
            <% } %>
        </div>
    </main>
</div>
<script>
    // Set default return date to 14 days from now
    const dateInput = document.getElementById('return-date');
    if (dateInput) {
        const d = new Date();
        d.setDate(d.getDate() + 14);
        dateInput.value = d.toISOString().split('T')[0];
    }
    document.getElementById('issue-form').addEventListener('submit', () => {
        const btn = document.getElementById('issue-btn');
        btn.textContent = 'Issuing...'; btn.disabled = true;
    });
</script>
</body>
</html>
