<%- include('partials/head', { pageTitle: 'Edit Student' }) %>
<body>
<div class="app-layout">
    <%- include('partials/sidebar', { activePage: 'students' }) %>

    <main class="main-content">
        <div class="page-header">
            <div>
                <h1 class="page-title">✏️ Edit Student</h1>
                <p class="page-subtitle">Update student information</p>
            </div>
            <a href="/students" class="btn btn-ghost">← Back to Students</a>
        </div>

        <div class="form-card">
            <h2>🎓 Editing: <%= student.name %> (<%= student.usn %>)</h2>

            <% if (error) { %>
                <div class="error-msg">⚠️ <%= error %></div>
            <% } %>

            <form action="/students/edit/<%= student.usn %>" method="post" id="edit-student-form">
                <div class="form-group">
                    <label>USN (cannot be changed)</label>
                    <input type="text" value="<%= student.usn %>" disabled style="opacity:0.5; cursor:not-allowed;">
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name *</label>
                        <input type="text" id="name" name="name" value="<%= student.name %>" required>
                    </div>
                    <div class="form-group">
                        <label for="branch">Branch *</label>
                        <select id="branch" name="branch" required>
                            <% ['CSE','ISE','ECE','ME','CV','EEE','CH','BT','MBA','MCA'].forEach(b => { %>
                                <option value="<%= b %>" <%= student.branch === b ? 'selected' : '' %>><%= b %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" value="<%= student.email || '' %>">
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary" id="submit-btn">💾 Save Changes</button>
                    <a href="/students" class="btn btn-ghost">Cancel</a>
                </div>
            </form>
        </div>
    </main>
</div>
<script>
    document.getElementById('edit-student-form').addEventListener('submit', () => {
        const btn = document.getElementById('submit-btn');
        btn.textContent = 'Saving...'; btn.disabled = true;
    });
</script>
</body>
</html>
